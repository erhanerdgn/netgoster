# NetGöster ortam değişkenleri — bu dosyayı `.env` olarak kopyalayıp doldurun (cp .env.example .env).
# DERLEME anında okunur: değiştirdikten sonra `pnpm build` / `pnpm deploy`. `.env` git'e eklenmez.
# GitHub Actions ile yayında aynı adları Settings → Secrets and variables → Actions → Variables altına ekleyin.

# Google AdSense yayıncı kimliği. Boşsa HİÇBİR reklam kodu yüklenmez, ads.txt boş kalır, çerez banner'ı görünmez.
# örn. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=

# Reklam birimi (slot) kimlikleri — AdSense › Reklamlar › Reklam birimine göre › Görüntülü reklam (duyarlı).
# Boş bırakılan birim çizilmez (Otomatik reklamlar açıksa Google kendisi yerleştirir).
# Araç sayfası: sonuç kartı / ödeme tablosunun hemen altı
VITE_AD_SLOT_RESULT=
# Araç sayfası: içerik arası (makale içi)
VITE_AD_SLOT_CONTENT=
# Araç sayfası: uzun içerikte ikinci içerik arası
VITE_AD_SLOT_CONTENT2=
# Araç sayfası: masaüstü sağ kenar, içindekilerin altında yapışkan 300×600 (dikey birim)
VITE_AD_SLOT_SIDEBAR=
# Araç sayfası: SSS'den sonra, ilgili hesaplamalardan önce
VITE_AD_SLOT_FOOTER=
# Ana sayfa (2 yer) ve kategori sayfaları (1 yer)
VITE_AD_SLOT_LIST=

# Arama motoru doğrulama (HTML etiketi yöntemindeki content="..." değeri)
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=

# Cloudflare (yalnız deploy için; GitHub Actions'ta aynı adlar repo SECRET'ı olarak durur)
# Token: Cloudflare › My Profile › API Tokens › Create Token › "Edit Cloudflare Workers" şablonu
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
