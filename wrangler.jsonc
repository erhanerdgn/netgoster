{
  "$schema": "node_modules/wrangler/config-schema.json",
  // netgoster.com — statik ön-render sayfalar (dist) + ince Worker: www→apex 301, güvenlik/önbellek başlıkları, /api/kurlar, /api/altin
  "name": "netgoster",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "netgoster.com", "custom_domain": true },
    { "pattern": "www.netgoster.com", "custom_domain": true },
  ],
  "observability": { "enabled": true },
}
